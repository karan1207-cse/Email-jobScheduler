# ReachInbox Email Job Scheduler - Environment Configuration Example
# Copy this file to .env and adjust variables as needed for your local environment.

# ==============================================================================
# General Environment Configuration
# ==============================================================================
NODE_ENV=development
PORT=5000
FRONTEND_URL=http://localhost:5173

# ==============================================================================
# Database Configuration (PostgreSQL)
# ==============================================================================
POSTGRES_USER=reachinbox
POSTGRES_PASSWORD=reachinbox_secret
POSTGRES_DB=reachinbox_db
POSTGRES_PORT=5432

# PostgreSQL Connection String used by backend API
DATABASE_URL=postgresql://reachinbox:reachinbox_secret@localhost:5432/reachinbox_db

# ==============================================================================
# Cache & Message Broker (Redis)
# ==============================================================================
REDIS_PORT=6379

# Redis Connection URL used by backend API and Worker
REDIS_URL=redis://localhost:6379

# ==============================================================================
# Worker & Rate Limiting Configuration (Milestone 4)
# ==============================================================================
# Concurrency per worker process (default: 5)
WORKER_CONCURRENCY=5

# Maximum emails per clock hour (per sender when RATE_LIMIT_SCOPE=per-sender), shared by all workers (default: 100, 0 = unlimited)
RATE_LIMIT_MAX_PER_HOUR=100

# Minimum interval between consecutive email sends in milliseconds (default: 1000ms = 1s, 0 = no pacing)
RATE_LIMIT_INTERVAL_MS=1000

# Rate limit scope: 'global' (shared limit) or 'per-sender' (independent per sender)
RATE_LIMIT_SCOPE=per-sender

# Redis key prefix for rate-limit and pacing coordination
RATE_LIMIT_KEY_PREFIX=rl:reachinbox

# ==============================================================================
# Authentication & Google OAuth (Milestone 6)
# ==============================================================================
# Session encryption secret (required in production)
SESSION_SECRET=dev-session-secret-change-in-production

# Google OAuth 2.0 Credentials (obtain from Google Cloud Console)
# Optional in local development; when unset, local dev bypasses to dev user
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:5000/auth/google/callback
# Local machine without Google keys: set to true, then open http://localhost:5000/auth/dev-login
# once to sign in as the built-in dev user (localhost only, never in production).
# ALLOW_DEV_LOGIN=true

# ==============================================================================
# Slack OAuth & Alerting (Milestone 8)
# ==============================================================================
# Slack App credentials (obtain from api.slack.com/apps)
# Optional in local development; when unset, manual incoming webhooks can still be configured
SLACK_CLIENT_ID=your-slack-client-id
SLACK_CLIENT_SECRET=your-slack-client-secret
SLACK_REDIRECT_URI=http://localhost:5000/auth/slack/callback

# ==============================================================================
# Elasticsearch (Milestone 9)
# ==============================================================================
# Elasticsearch cluster URL — uses docker-compose service or managed cloud instance
ELASTICSEARCH_URL=http://localhost:9200
# Optional: name of the emails index (default: reachinbox_emails)
ELASTICSEARCH_INDEX=reachinbox_emails
# Set to 'false' only if using self-signed TLS in local development
# ELASTICSEARCH_TLS_REJECT_UNAUTHORIZED=false

# ==============================================================================
# Admin API (Milestone 9)
# ==============================================================================
# Long random secret to protect /api/search/rebuild and /admin/queues in production.
# If unset:
#   - /api/search/rebuild is localhost-only
#   - /admin/queues dashboard is localhost-only (dev) or disabled (production)
# ADMIN_TOKEN=change-this-to-a-long-random-secret
# Open the dashboard once with http://localhost:5000/admin/queues?token=<ADMIN_TOKEN>;
# the token is then kept in an HTTP-only cookie for that path.
# Extra client IPs allowed to open /admin/queues in development (comma separated).
# Default 10.0.2.2 = the VirtualBox NAT host, so a laptop-to-VM port forward works.
# DASHBOARD_ALLOWED_IPS=10.0.2.2
# In development, this Google account may also access /admin/queues remotely
# through the authenticated app session (for example, from a host-to-VM port forward).
# ADMIN_EMAIL=admin@example.com

# ==============================================================================
# BullMQ Queue Dashboard (Milestone 9)
# ==============================================================================
# The queue name watched by Bull Board (must match the worker queue name)
EMAIL_QUEUE_NAME=email-jobs

# ==============================================================================
# Frontend Environment Configuration (Vite)
# ==============================================================================
VITE_API_URL=http://localhost:5000

# Optional SMTP relay. Leave all three credential values empty for Ethereal test mail
# in development. The worker rejects partial credential sets.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=ReachInbox Scheduler <scheduler@reachinbox.local>

# Optional host ports for Docker Compose
API_PORT=5000
WEB_PORT=5173
ELASTICSEARCH_PORT=9200
