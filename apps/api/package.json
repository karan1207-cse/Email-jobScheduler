{
  "name": "@reachinbox/api",
  "version": "1.0.0",
  "description": "Express + TypeScript REST API for ReachInbox Email Scheduler",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "prisma:generate": "prisma generate --schema=prisma/schema.prisma",
    "prisma:migrate": "prisma migrate deploy --schema=prisma/schema.prisma",
    "dev": "tsx watch src/index.ts",
    "build": "npm run prisma:generate && tsc",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "@bull-board/api": "^9.10.4",
    "@bull-board/express": "^9.10.4",
    "@elastic/elasticsearch": "^8.19.2",
    "@prisma/client": "^6.19.3",
    "@reachinbox/shared": "*",
    "@types/nodemailer": "^8.0.2",
    "bullmq": "^6.3.15",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-session": "^1.19.0",
    "google-auth-library": "^11.3.1",
    "ioredis": "^5.6.0",
    "nodemailer": "^10.1.2",
    "pg": "^8.13.3",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/express-session": "^1.19.0",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.11.11",
    "@types/supertest": "^6.0.2",
    "prisma": "^6.19.3",
    "rimraf": "^6.0.1",
    "supertest": "^7.0.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "vitest": "^3.0.7"
  }
}
