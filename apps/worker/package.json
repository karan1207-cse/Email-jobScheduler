{
  "name": "@reachinbox/worker",
  "version": "1.0.0",
  "description": "Background BullMQ email worker for ReachInbox Email Scheduler",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "prisma:generate": "node scripts/sync-prisma-client.mjs",
    "predev": "npm run prisma:generate",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "prebuild": "npm run prisma:generate",
    "build": "tsc",
    "clean": "rimraf dist",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@elastic/elasticsearch": "^8.19.2",
    "@prisma/client": "^6.19.3",
    "@reachinbox/shared": "*",
    "bullmq": "^6.3.15",
    "dotenv": "^16.4.7",
    "ioredis": "^5.6.0",
    "nodemailer": "^10.1.2"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/nodemailer": "^6.4.17",
    "rimraf": "^6.0.1",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "vitest": "^3.0.7"
  }
}
